{
  "ai-tools-shield": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|grep_search|find_by_name|list_dir|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{ "type": "command", "command": "node ~/.claude/ai_tools/hooks/privacy-shield.mjs", "timeout": 10 }]
      }
    ]
  }
}
