{
  "name": "typo3-ai-suite",
  "version": "1.0.0",
  "description": "Universal AI Rules, MCP Server & Security Automation for TYPO3 CMS",
  "private": true,
  "type": "module",
  "workspaces": [
    "typo3-mcp-server"
  ],
  "scripts": {
    "sync-ai": "node scripts/sync-ai-configs.js",
    "setup:project": "node scripts/setup-project.js",
    "learn:advisories": "node scripts/learn-advisories.js",
    "knowledge:index": "node scripts/knowledge.js --index",
    "knowledge:query": "node scripts/knowledge.js",
    "learn:rector": "node scripts/generate-rector.js",
    "audit:pr": "node scripts/security-audit-pr.js",
    "build": "npm run build --workspace=typo3-mcp-server",
    "test:advisories": "node --test tests/advisory-distiller.test.js",
    "test:learning": "npm run build && node --test tests/knowledge-store.test.js tests/security-review.test.js tests/mcp-learning.test.js tests/rector-learning.test.js",
    "test:phpstan": "cd typo3-security-suite && ./vendor/bin/phpstan analyse -c phpstan.neon rules/",
    "test:fluid": "python3 typo3-security-suite/scripts/scan_fluid_xss.py tests/fixtures/vulnerable_extension/Resources/Private/Templates/",
    "test": "npm run test:advisories && npm run test:learning && npm run test:exchange && npm run test:regression && npm run test:assets && npm run test:docs && npm run test:phpstan",
    "test:regression": "node --test tests/advisory-regression.test.js",
    "fixtures:status": "node scripts/fixture-status.js",
    "knowledge:export": "node scripts/knowledge-export.js",
    "knowledge:import": "node scripts/knowledge-import.js",
    "test:exchange": "node --test tests/knowledge-exchange.test.js",
    "fixtures:review": "node scripts/fixture-review.js",
    "test:docs": "node --test tests/i18n.test.js",
    "scan:assets": "node scripts/scan-assets.js",
    "scan:js": "node scripts/scan-assets.js --js",
    "scan:typoscript": "node scripts/scan-assets.js --typoscript",
    "test:assets": "node --test tests/asset-regression.test.js"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5"
  },
  "keywords": [
    "typo3",
    "mcp",
    "ai",
    "security",
    "phpstan",
    "cursor",
    "claude",
    "windsurf",
    "copilot"
  ],
  "author": "TYPO3 Security & AI Community",
  "license": "GPL-2.0-or-later"
}
